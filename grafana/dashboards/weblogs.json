          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weblogs-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS requests FROM access_logs WHERE $__timeFilter(ts) AND method IN ($method) AND traffic_type IN ($traffic_type)"
        }
      ],
      "fieldConfig": {
        "defaults": {
