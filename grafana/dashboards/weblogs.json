    {
      "id": 8,
      "type": "timeseries",
      "title": "Error rate over time (%)",
      "description": "Watch for spikes - a burst of 5xx usually means an outage or a bad deploy.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "weblogs-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "weblogs-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), 100.0 * count(*) FILTER (WHERE status >= 400) / count(*) AS \"errors %\", 100.0 * count(*) FILTER (WHERE status >= 500) / count(*) AS \"server errors (5xx) %\" FROM access_logs WHERE $__timeFilter(ts) AND method IN ($method) AND traffic_type IN ($traffic_type) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "errors %"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "server errors (5xx) %"
